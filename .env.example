# =====================================================================
#  Telegram Personal Archive — konfiguratsiya namunasi
#  Nusxa oling:  cp .env.example .env   va  chmod 600 .env
#  .env faylini HECH QACHON Git'ga qo'shmang va hech kimga yubormang.
# =====================================================================

# ---------- Umumiy (archiver ham, bot ham o'qiydi) ----------
# Barcha ish ma'lumotlari shu katalog ichida saqlanadi (baza, media, session, zaxira).
DATA_DIR=./data
# Ixtiyoriy: alohida yo'llar. Bo'sh qoldirilsa DATA_DIR ichidan olinadi.
# DB_PATH=./data/db/archive.sqlite3
# MEDIA_DIR=./data/media
# EXPORT_DIR=./data/exports
# BACKUP_DIR=./data/backups

LOG_LEVEL=INFO
# json — server uchun (journald/docker logs), console — lokal ishlash uchun
LOG_FORMAT=json
# SQLite band bo'lsa necha millisekund kutish
DB_BUSY_TIMEOUT_MS=10000
# Bot natijalarida vaqtni ko'rsatish mintaqasi (bazada har doim UTC)
DISPLAY_TIMEZONE=Asia/Tashkent
# Shaxsiy ma'lumotlarni saqlash muddati (kun). Bo'sh = doimiy saqlash (tanlangan qaror).
# RETENTION_DAYS=

# ---------- Archiver (asosiy akkaunt, MTProto) ----------
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Session fayli nomi: DATA_DIR/session/<nom>.session
TG_SESSION_NAME=archiver

# Qaysi chat turlari arxivlansin
ARCHIVE_PRIVATE=true
ARCHIVE_BOTS=false
ARCHIVE_SAVED=true
ARCHIVE_GROUPS=true
ARCHIVE_CHANNELS=true
# Vergul bilan ajratilgan chat ID'lar. Allowlist bo'sh bo'lmasa, FAQAT shu chatlar arxivlanadi.
CHAT_ALLOWLIST=
CHAT_DENYLIST=

# Eski tarix importi
HISTORY_ENABLED=true
HISTORY_PAGE_SIZE=100
HISTORY_PAGE_DELAY_S=1.0
# Necha kun orqagacha import qilish. Bo'sh = butun tarix.
HISTORY_MAX_AGE_DAYS=
# Takeout ishlatilmaydi: archiver oddiy ikkinchi sessiya, ma'lumot oddiy arxivga yoziladi.
# Shu sekundgacha bo'lgan FloodWait'ni Telethon o'zi kutadi
FLOOD_SLEEP_THRESHOLD_S=60
# Uzunroq FloodWait'da chat keyinga qoldiriladi, ishchi ko'pi bilan shuncha kutadi
MAX_FLOOD_WAIT_S=3600
# Dialoglar va yangi xabarlarni tekshirish oralig'i (sekund). Real vaqt yoqilgan bo'lsa —
# hodisalar o'tkazib yuborilgan holatlar uchun solishtirish (reconcile).
SYNC_INTERVAL_S=600
# Real vaqt hodisalari: yangi xabarlar darhol, tahrirlar tarixi va o'chirishlar qayd etiladi
REALTIME_ENABLED=true

# Kanallar: faqat kanal ma'lumoti va oxirgi N ta post saqlanadi (0 = to'liq tarix).
# Eskiroq postlar arxivdan olib tashlanadi, reply qilingan postlar bundan mustasno.
CHANNEL_KEEP_POSTS=20
# Saqlangan postlarga yozilgan izohlar (reply'lar) — har biri saqlanadi
CHANNEL_SAVE_COMMENTS=true
# Yangi post bo'lmasa ham kanal oynasi va izohlar shu oraliqda tekshiriladi (sekund)
CHANNEL_REFRESH_INTERVAL_S=3600

# Media arxivi: shaxsiy chat va guruhlardagi fayllar
MEDIA_ENABLED=true
# Ruxsat etilgan turlar: photo,video,voice,audio,document,animation,sticker,video_note
MEDIA_TYPES=photo,video,voice,audio,document,animation,video_note
# Kanallardan media yuklash
MEDIA_IN_CHANNELS=false
# Bitta fayl uchun chegara (MB). Kattaroq fayl YUKLANMAYDI, lekin "katta fayl" sifatida
# nomi, hajmi, turi va qaysi xabarda ekani saqlanadi: tgarchive media large
# Kerakli bittasini baribir yuklash: tgarchive media fetch <ID>
MEDIA_MAX_FILE_MB=50
# Barcha media uchun umumiy chegara (GB). Bo'sh = cheklanmagan (faqat MEDIA_MIN_FREE_GB himoyasi).
MEDIA_MAX_TOTAL_GB=
# Diskda shuncha GB'dan kam joy qolsa, yuklash to'xtaydi (navbat saqlanadi)
MEDIA_MIN_FREE_GB=5
MEDIA_CONCURRENCY=2
MEDIA_MAX_ATTEMPTS=5
# Eslatma: himoyalangan (noforwards) chat va xabarlardan hamda bir marta ko'riladigan
# (view-once) mediadan fayl HECH QACHON yuklanmaydi.

HEARTBEAT_INTERVAL_S=30

# ---------- Admin bot (ikkinchi akkaunt boshqaradi) ----------
# @BotFather dan olingan token
BOT_TOKEN=
# Ikkinchi akkauntingizning Telegram user ID'si. Bot faqat shu ID uchun ishlaydi.
OWNER_ID=
BOT_PAGE_SIZE=10
